# Dominio definitivo de ESTA landing una vez conectado en Vercel.
# Mientras no exista, se usa un placeholder claramente identificable
# (ver src/lib/seo.ts) y el build sigue funcionando con normalidad.
NEXT_PUBLIC_SITE_URL=https://TU-DOMINIO-PENDIENTE.vercel.app

# Número de WhatsApp de contacto — PENDIENTE de confirmar. Formato
# internacional, solo dígitos (p. ej. 34600000000). Vacío = los CTA de
# WhatsApp llevan a la sección #consulta (ver src/lib/whatsapp.ts).
NEXT_PUBLIC_WHATSAPP_NUMBER=
